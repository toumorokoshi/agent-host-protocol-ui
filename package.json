{
	"name": "@toumorokoshi/agent-host-protocol-ui",
	"version": "0.2.0",
	"description": "Client-side web UI for the Agent Host Protocol (AHP) inspired by VS Code Agents view",
	"author": "Yusuke Tsutsumi <yusuke@tsutsumi.io>",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist-path.js",
	"types": "./dist-path.d.ts",
	"bin": {
		"agent-host-protocol-ui": "bin/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"bin",
		"dist-path.js",
		"dist-path.d.ts"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toumorokoshi/agent-host-protocol-ui.git"
	},
	"bugs": {
		"url": "https://github.com/toumorokoshi/agent-host-protocol-ui/issues"
	},
	"homepage": "https://github.com/toumorokoshi/agent-host-protocol-ui#readme",
	"keywords": [
		"agent-host-protocol",
		"ahp",
		"ai-agents",
		"vs-code",
		"ui",
		"web-ui",
		"agent-ui",
		"client"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "node --test",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build && npm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@microsoft/agent-host-protocol": "^1.0.0",
		"dompurify": "^3.4.16",
		"marked": "^18.0.14",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
